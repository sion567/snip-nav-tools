{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnipNav",
  "version": "0.1.0",
  "identifier": "io.github.snipnav",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "SnipNav · 本地命令速查",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0d1117"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
